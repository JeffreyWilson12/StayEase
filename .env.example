# Copy this file to .env and replace the placeholder values.
# The real .env file is git-ignored and must never be committed.

MYSQL_DATABASE=hotelmanagementdb
MYSQL_ROOT_PASSWORD=change-me-to-a-strong-password
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=change-me-to-a-strong-password

# Optional: comma-separated front-end origins allowed by the API (CORS)
# APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
